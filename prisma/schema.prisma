// Esquema de Sophon Promoters.
//
// Principio rector: el dinero se guarda SIEMPRE como BigInt en micros de dólar
// (1 $ = 1.000.000 µ$). Ni Float ni Decimal: los importes llegan de Sophon como
// cadena y se convierten con `lib/devengo/dinero.ts`.
//
// El ledger (`AsientoComision`) es append-only: una corrección se escribe como
// una línea negativa fechada el día del ajuste, nunca mutando el asiento original.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enumeraciones ───────────────────────────────

enum EstadoAgente {
  PENDIENTE // creado por código de activación, aún sin verificar el email
  ACTIVO
  SUSPENDIDO
  BAJA
}

enum OrigenAtribucion {
  VINCULADO_APP // el agente lo activó desde la Mini App: atribución limpia
  ASIGNADO_MANUAL // el Operador se lo asignó después: devengo prospectivo
  HUERFANO // existía en Sophon antes que la app; sin agente
}

enum EstadoSophon {
  DESCONOCIDO
  ACTIVO
  BLOQUEADO
  PENDIENTE_BORRADO
}

enum PropositoOtp {
  VINCULAR_CUENTA
  RECUPERAR_ACCESO
}

enum MotivoConcesion {
  ALTA // acompaña al alta de un webmaster nuevo
  RENOVACION // el PRO se estaba apagando y se ha vuelto a encender
}

enum EstadoConcesion {
  RESERVADA // fila escrita antes de llamar a Sophon, aún sin confirmar
  CONFIRMADA
  FALLIDA
}

enum TipoAsiento {
  CPA // comisión por registro de usuario
  CPS // comisión por compra de PRO
  BONO // premio mensual por alcanzar un hito de registros
  AJUSTE_REVERSO // Sophon revisó a la baja un día ya cerrado
  AJUSTE_MANUAL
  RETIRO // salida de saldo al pagar al agente
}

enum EstadoAsiento {
  PROVISIONAL // el día sigue abierto y puede cambiar
  CONSOLIDADO // el día quedó fuera de la ventana de revisión
  ANULADO
}

enum EstadoRetiro {
  SOLICITADO
  APROBADO
  RECHAZADO
  PAGADO
  CANCELADO
}

enum RedCripto {
  TRC20
  BSC
  TON
}

enum TipoSync {
  REGISTROS
  WEBMASTERS
  TESORERIA
  CADUCIDADES
  TARIFAS
  /// Barrido diario que avisa al agente de sus webmasters apagados o con
  /// incidencia. Distinto de CADUCIDADES: ese nombra plazos de PRO, y el PRO
  /// no entra en este aviso.
  AVISOS
}

enum EstadoSync {
  EN_CURSO
  COMPLETADA
  PARCIAL
  FALLIDA
}

enum ActorTipo {
  AGENTE
  /// Quien administra: reparte códigos, fija tarifas y paga los retiros.
  /// Se llamaba SUPERADMIN mientras el proyecto estuvo sin desplegar; el esquema
  /// inicial ya lo crea con este nombre, así que no hay ninguna migración de
  /// renombrado que aplicar.
  OPERADOR
  SISTEMA
}

// ──────────────────────────────── Identidad ────────────────────────────────

model Agente {
  id String @id @default(cuid())

  /// El email es el identificador de acceso. Se guarda normalizado (minúsculas,
  /// sin espacios) y es único; `emailOriginal` conserva lo que escribió la persona.
  emailNormalizado String  @unique
  emailOriginal    String
  nombreVisible    String
  telegramId       BigInt? @unique
  telegramUsuario  String?

  estado EstadoAgente @default(PENDIENTE)

  /// Comisiones propias del agente. Si son null, se aplican las de configuración.
  /// Nunca se leen para recalcular el histórico: cada asiento congela su tarifa.
  cpaPorRegistroMicros BigInt?
  cpsBps               Int?

  /// NO hay tope de altas, y es una decisión, no un olvido.
  ///
  /// Un agente puede dar de alta cuantos webmasters quiera. Las dos únicas
  /// condiciones las impone la realidad y no un contador: el webmaster tiene
  /// que existir ya en newSophon.com —si no, `bind_sub_aff` responde «user not
  /// found»— y no puede estar vinculado a otro agente, que es exactamente lo
  /// que garantiza el índice único sobre `Webmaster.emailNormalizado`.
  ///
  /// Poner además un cupo mensual habría frenado justo lo que da dinero. Para
  /// parar a un agente concreto está `estado`, que corta también su sesión.

  /// Idioma en el que se le habla desde el SERVIDOR.
  ///
  /// La Mini App no lo necesita —lo saca de `initDataUnsafe` en cada carga—,
  /// pero el bot sí: cuando el Operador resuelve un retiro no hay ninguna
  /// actualización de Telegram de la que leer `language_code`, así que sin esta
  /// columna el aviso de «te hemos pagado» saldría en español para todo el
  /// mundo. Se escribe al vincular la cuenta y se refresca en cada `/start`.
  idioma String @default("es")

  /// Invalidación instantánea de todas las sesiones: basta con incrementarlo.
  epocaSesion Int @default(0)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  webmasters    Webmaster[]
  sesiones      SesionAgente[]
  asientos      AsientoComision[]
  retiros       SolicitudRetiro[]
  concesiones   ConcesionPro[]
  vinculaciones IntentoVinculacion[]
  codigoUsado   CodigoActivacion?

  @@index([estado])
}

model SesionAgente {
  id       String @id @default(cuid())
  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id], onDelete: Cascade)

  /// Solo el hash: el token opaco jamás se persiste en claro.
  tokenHash   String @unique
  epocaSesion Int

  telegramId    BigInt
  emitidaEn     DateTime  @default(now())
  expiraEn      DateTime
  ultimoUsoEn   DateTime  @default(now())
  revocadaEn    DateTime?
  ip            String?
  agenteUsuario String?

  @@index([agenteId, revocadaEn])
  @@index([expiraEn])
}

/// Sesión del panel de Operador.
///
/// No hay contraseña: el bot emite un enlace de un solo uso al Telegram del
/// Operador, que ya es el ancla de confianza de toda la aplicación
/// (`TELEGRAM_OPERADOR_ID`). Una contraseña más en el entorno sería una
/// credencial más que rotar, filtrar y olvidar, sin añadir ninguna garantía
/// que el control del Telegram no diera ya.
///
/// Dura poco a propósito: al panel se entra a hacer algo concreto —pagar un
/// retiro, subir un cupo— y una sesión eterna sobre la mesa de un portátil es
/// justo lo que no puede quedar abierto.
model SesionAdmin {
  id String @id @default(cuid())

  /// Solo el hash, como en las sesiones de agente.
  tokenHash String @unique

  /// Token de un solo uso del enlace de entrada. Se borra al canjearlo, así
  /// que un enlace reenviado por error no vale dos veces.
  canjeHash String?   @unique
  canjeadoEn DateTime?

  telegramId  BigInt
  emitidaEn   DateTime  @default(now())
  expiraEn    DateTime
  ultimoUsoEn DateTime  @default(now())
  revocadaEn  DateTime?
  ip          String?

  @@index([expiraEn])
}

/// Código que genera el Operador desde el bot para dar de alta a un agente.
model CodigoActivacion {
  id     String @id @default(cuid())
  codigo String @unique

  /// Si se fija, solo ese email puede canjearlo.
  emailDestino String?
  usosMaximos  Int     @default(1)
  usosActuales Int     @default(0)

  expiraEn    DateTime
  creadoPorId String
  anuladoEn   DateTime?
  creadoEn    DateTime  @default(now())

  agenteId String? @unique
  agente   Agente? @relation(fields: [agenteId], references: [id])

  @@index([expiraEn, anuladoEn])
}

model CodigoOtp {
  id               String       @id @default(cuid())
  emailNormalizado String
  /// Hash con pimienta: un volcado de la tabla no permite iniciar sesión.
  codigoHash       String
  proposito        PropositoOtp
  telegramId       BigInt?

  intentos    Int       @default(0)
  maxIntentos Int       @default(5)
  expiraEn    DateTime
  consumidoEn DateTime?
  creadoEn    DateTime  @default(now())

  @@index([emailNormalizado, proposito, consumidoEn])
  @@index([expiraEn])
  /// El techo de envíos por cuenta de Telegram (`/api/auth/codigo`) cuenta
  /// filas por `telegramId` dentro de una ventana de minutos. Sin este índice
  /// esa cuenta recorre la tabla entera, y la tabla crece con cada intento de
  /// entrada de todos los agentes: el freno contra el abuso sería justo lo que
  /// más costaría servir cuando alguien abusara.
  @@index([telegramId, creadoEn])
}

// ─────────────────────── Webmasters y su atribución ───────────────────────

model Webmaster {
  id String @id @default(cuid())

  /// Candado global de atribución: un email no puede pertenecer a dos agentes.
  emailNormalizado String  @unique
  emailOriginal    String
  uidSophon        String? @unique

  /// Nulo = del Operador. Un agente solo puede tener aquí cuentas que haya
  /// dado de alta él: la adopción de filas preexistentes está cerrada, porque
  /// una fila sin agente solo puede haberla creado un barrido, y los barridos
  /// recorren el árbol del Operador.
  agenteId    String?
  agente      Agente?          @relation(fields: [agenteId], references: [id], onDelete: SetNull)
  origen      OrigenAtribucion @default(HUERFANO)
  atribuidoEn DateTime?

  /// Frontera del devengo prospectivo: no se paga nada anterior a esta fecha.
  /// Se estampa en toda alta aunque una cuenta nueva no tenga historia que
  /// excluir: es lo que garantiza que el agente no cobre nada anterior a su
  /// alta sin depender de que Sophon nos haya dicho la verdad sobre la cuenta.
  devengaDesde DateTime?

  estadoSophon        EstadoSophon @default(DESCONOCIDO)
  vistoPorUltimaVezEn DateTime?
  desaparecidoEn      DateTime?

  /// Cuándo se comprobó contra Sophon que este webmaster aparece de verdad en
  /// el programa de socios.
  ///
  /// Hace falta porque `bind_sub_aff` devuelve un `void`: la única prueba de que
  /// vinculó era que no lanzara excepción. Nulo significa **pendiente de
  /// confirmar**, que no es lo mismo que «comprobado y no está»: Sophon puede
  /// tardar en propagar la vinculación, así que el alta no falla por eso y el
  /// barrido siguiente la sella.
  confirmadoEn DateTime?

  /// Materializado desde la respuesta de setmembership: no hay endpoint que lo
  /// consulte. Es la ÚNICA fuente de la caducidad del PRO.
  proVigenteHasta DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  filasDiarias  FilaDiariaSophon[]
  asientos      AsientoComision[]
  concesiones   ConcesionPro[]
  vinculaciones IntentoVinculacion[]

  @@index([agenteId, estadoSophon])
  @@index([proVigenteHasta])
}

/// Bitácora de cada llamada a bind_sub_aff. Es la prueba documental de la atribución.
model IntentoVinculacion {
  id               String @id @default(cuid())
  emailNormalizado String

  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id])

  webmasterId String?
  webmaster   Webmaster? @relation(fields: [webmasterId], references: [id])

  exito           Boolean   @default(false)
  codigoRespuesta Int?
  mensaje         String?
  traceId         String?
  creadoEn        DateTime  @default(now())
  resueltoEn      DateTime?

  @@index([emailNormalizado, creadoEn])
  /// El tope mensual de altas se cuenta AQUÍ y no sobre `Webmaster`: al
  /// deshacer un alta rechazada por Sophon se pone `atribuidoEn` a null, así
  /// que contar sobre el webmaster permitiría dar de alta y desvincular en
  /// bucle sin gastar cupo. Un intento con éxito no se borra ni se edita.
  @@index([agenteId, exito, creadoEn])
}

// ────────────────────── El hecho contable que da Sophon ──────────────────────

/// Una fila de `cpacps/detail/register` agrupada por webmaster y día.
///
/// La clave natural (webmaster, fecha) hace que re-sincronizar sea un upsert
/// idempotente: por muchas veces que corra el barrido, no se duplica nada.
model FilaDiariaSophon {
  id String @id @default(cuid())

  webmasterId String
  webmaster   Webmaster @relation(fields: [webmasterId], references: [id], onDelete: Cascade)
  fecha       DateTime  @db.Date

  countRegister   Int
  countT1Register Int
  countT2Register Int
  countT3Register Int
  countPayingUsers Int

  /// Importe pagado por los usuarios, en micros.
  paymentAmountMicros BigInt

  /// `myEarning` con affiliateLevel=1: ganancia TOTAL del registro.
  gananciaTotalMicros BigInt

  /// `myEarning` con affiliateLevel=2: ganancia del WEBMASTER.
  gananciaWebmasterMicros BigInt

  /// Diferencia de las dos anteriores: lo que entra al Operador. Es privado.
  gananciaOperadorMicros BigInt

  /// Un día sigue abierto mientras Sophon pueda revisarlo.
  cerrado      Boolean  @default(false)
  primeraVezEn DateTime @default(now())
  ultimaVezEn  DateTime @updatedAt

  asientos AsientoComision[]

  @@unique([webmasterId, fecha])
  @@index([fecha])
  @@index([cerrado, fecha])
}

// ───────────────────────────────── El ledger ─────────────────────────────────

/// Tarifa vigente en un intervalo. Cada asiento apunta a la suya, de modo que
/// cambiar las comisiones nunca reescribe el histórico.
/// La escalera de bonos vigente.
///
/// Versionada como `TarifaVersion` y por el mismo motivo: cada asiento de BONO
/// apunta al escalón que lo explica, así que editar un escalón en sitio
/// cambiaría la explicación de dinero ya pagado. Guardar cierra la vigente con
/// `validaHasta` y abre otra.
model BonoVersion {
  id String @id @default(cuid())

  validaDesde DateTime  @default(now())
  validaHasta DateTime?
  creadoPorId String?
  nota        String?

  escalones BonoEscalon[]

  @@index([validaDesde, validaHasta])
}

/// Un peldaño: alcanzar `usuarios` registros en el mes paga `recompensaMicros`.
///
/// Las recompensas tienen que CRECER con los usuarios. El devengo asienta la
/// diferencia entre el objetivo y lo ya pagado, así que un escalón alto que
/// pagara menos que uno bajo daría una diferencia negativa —un asiento que le
/// quita dinero al agente por haber trabajado más—. Se valida al guardar.
model BonoEscalon {
  id String @id @default(cuid())

  versionId String
  version   BonoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  /// Registros del mes natural que hay que alcanzar.
  usuarios         Int
  recompensaMicros BigInt

  asientos AsientoComision[]

  @@unique([versionId, usuarios])
  @@index([versionId])
}

model TarifaVersion {
  id String @id @default(cuid())

  cpaPorRegistroMicros BigInt
  cpsBps               Int
  /// Nivel de partner de Sophon vigente cuando se creó, solo informativo.
  partnerLevel         Int?

  validaDesde DateTime  @default(now())
  validaHasta DateTime?
  creadoPorId String?
  nota        String?

  asientos AsientoComision[]

  @@index([validaDesde, validaHasta])
}

/// Libro mayor. Append-only: nada se actualiza salvo el paso de PROVISIONAL a
/// CONSOLIDADO. Cualquier corrección entra como asiento nuevo de signo contrario.
model AsientoComision {
  id String @id @default(cuid())

  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id])

  webmasterId String?
  webmaster   Webmaster? @relation(fields: [webmasterId], references: [id])

  filaId String?
  fila   FilaDiariaSophon? @relation(fields: [filaId], references: [id])

  tipo   TipoAsiento
  estado EstadoAsiento @default(PROVISIONAL)

  /// Importe devengado por el agente, en micros. Negativo en reversos y retiros.
  importeMicros BigInt

  /// Base sobre la que se calculó, para poder auditar el asiento sin recalcular.
  baseRegistros Int?
  baseMicros    BigInt?

  tarifaId String?
  tarifa   TarifaVersion? @relation(fields: [tarifaId], references: [id])

  /// El escalón que explica un asiento de BONO. Nulo en todos los demás tipos.
  bonoEscalonId String?
  bonoEscalon   BonoEscalon? @relation(fields: [bonoEscalonId], references: [id])

  /// Fecha del hecho económico. Un reverso lleva la fecha del ajuste, no la del original.
  fechaDevengo DateTime @db.Date

  /// Idempotencia: el motor construye una clave estable por (fila, tipo, versión)
  /// y la base de datos impide que un segundo barrido escriba dos veces lo mismo.
  claveIdempotencia String @unique

  retiroId String?
  retiro   SolicitudRetiro? @relation(fields: [retiroId], references: [id])

  creadoEn DateTime @default(now())
  nota     String?

  @@index([agenteId, fechaDevengo])
  @@index([agenteId, estado])
  @@index([fechaDevengo])
}

// ──────────────────────────── Concesiones y retiros ────────────────────────────

model ConcesionPro {
  id String @id @default(cuid())

  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id])

  webmasterId String
  webmaster   Webmaster @relation(fields: [webmasterId], references: [id])

  /// Siempre `vip.year`. Se guarda lo que se mandó, no lo que se supone.
  codigoMembresia String

  /// Segundos pedidos a Sophon. NO es decorativo: el código de membresía no
  /// decide el plazo —`duration: 0` da 30 días con cualquier código—, así que
  /// esta columna es el único registro de qué se concedió de verdad.
  duracionSegundos Int

  /// Por qué se concedió. El alta y la renovación son el mismo acto técnico y
  /// dos hechos comerciales distintos, y separarlos aquí evita tener que
  /// deducirlo después comparando fechas.
  motivo MotivoConcesion

  estado EstadoConcesion @default(RESERVADA)

  /// Única fuente de la caducidad: la respuesta de setmembership.
  vigenteHasta DateTime?

  /// El `membership_start_at` que devuelve Sophon, y el detector de la única
  /// pregunta que esta integración no ha podido responder: al conceder sobre
  /// una membresía viva, ¿el plazo se SUMA o se SUSTITUYE?
  ///
  /// La aplicación solo leía `membership_end_at` y sobrescribía la caducidad sin
  /// compararla con la anterior, así que adoptaba la respuesta como verdad sin
  /// enterarse de si acababa de perder tiempo. Si el inicio se mueve a hoy, es
  /// que sustituye.
  ///
  /// La regla de vigencia (`lib/pro/vigencia.ts`) hace que el caso no se pueda
  /// provocar desde la renovación, pero sigue ocurriendo de forma legítima al
  /// dar de alta a un huérfano que ya venía con PRO. Esta columna deja el
  /// detector puesto para la primera vez que pase.
  vigenteDesde DateTime?

  uidSophon String?

  /// Impide que un doble toque conceda dos años en vez de uno.
  claveIdempotencia String @unique

  traceId  String?
  mensaje  String?
  creadoEn DateTime @default(now())

  @@index([agenteId, creadoEn])
  @@index([webmasterId])
}

/// ⚠️ ESTE MODELO TIENE UN ÍNDICE QUE NO SE VE AQUÍ.
///
/// `SolicitudRetiro_una_viva_por_agente` es un índice único PARCIAL —a lo sumo
/// una solicitud por agente entre las que están vivas (SOLICITADO o APROBADO), y
/// sin restricción sobre las resueltas— y Prisma no sabe expresar índices
/// parciales, así que vive solo en la migración
/// `20260817090000_una_solicitud_viva_por_agente`.
///
/// Es lo ÚNICO que sostiene «una sola solicitud viva por agente». Antes la regla
/// era un `findFirst` dentro de una transacción, y en READ COMMITTED —el nivel
/// por defecto de las transacciones de Prisma— eso no bloquea nada: dos toques
/// simultáneos creaban dos solicitudes del mismo saldo y el Operador las
/// aprobaba a mano sin ver que eran la misma.
///
/// Si `prisma migrate dev` propone borrarlo alguna vez, la respuesta es que no.
model SolicitudRetiro {
  id String @id @default(cuid())

  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id])

  importeMicros BigInt
  red           RedCripto
  wallet        String

  estado EstadoRetiro @default(SOLICITADO)

  solicitadoEn DateTime  @default(now())
  resueltoEn   DateTime?
  resueltoPor  String?
  motivo       String?
  /// Hash de la transacción, cuando el Operador la marca como pagada.
  referenciaPago String?

  claveIdempotencia String @unique

  asientos AsientoComision[]

  @@index([agenteId, estado])
  @@index([estado, solicitadoEn])
}

// ──────────────────────────── Operación del sistema ────────────────────────────

model EjecucionSync {
  id     String     @id @default(cuid())
  tipo   TipoSync
  estado EstadoSync @default(EN_CURSO)

  desde DateTime?
  hasta DateTime?

  filasLeidas    Int @default(0)
  filasEscritas  Int @default(0)
  asientosCreados Int @default(0)

  iniciadaEn  DateTime  @default(now())
  terminadaEn DateTime?
  error       String?

  @@index([tipo, iniciadaEn])
}

/// Resultado de cuadrar nuestro ledger contra las cifras de Sophon.
/// Un descuadre no se ignora: se registra y alerta.
model Conciliacion {
  id    String   @id @default(cuid())
  fecha DateTime @default(now())

  totalSophonMicros BigInt
  totalLocalMicros  BigInt
  descuadreMicros   BigInt

  cuadra Boolean
  detalle String?

  @@index([fecha])
}

model Auditoria {
  id String @id @default(cuid())

  actorTipo ActorTipo
  actorId   String?
  accion    String
  recurso   String?
  detalle   Json?
  ip        String?

  creadoEn DateTime @default(now())

  @@index([actorTipo, actorId, creadoEn])
  @@index([accion, creadoEn])
}

model Configuracion {
  clave         String   @id
  valor         String
  actualizadoEn DateTime @updatedAt
}

/// Cerrojo de exclusión entre barridos, en una FILA y no en un bloqueo
/// consultivo de Postgres.
///
/// Los consultivos son por SESIÓN, y Prisma reparte las consultas entre las
/// conexiones de un pool: el `pg_try_advisory_lock` caía en una conexión y el
/// `pg_advisory_unlock` en otra, de modo que el bloqueo no se soltaba nunca y a
/// partir de ahí todos los barridos se saltaban en silencio. Se vio en el log de
/// la base: «you don't own a lock of type ExclusiveLock».
model Cerrojo {
  clave String @id

  /// Identificador del proceso que lo tiene. Se compara al soltarlo para no
  /// quitarle el cerrojo a quien lo haya tomado después de caducar el nuestro.
  duenno String

  tomadoEn DateTime @default(now())

  /// Caducidad. Es el seguro contra un proceso que muere a mitad de barrido:
  /// sin ella, un reinicio en el peor momento dejaría el cerrojo tomado para
  /// siempre y ningún barrido volvería a correr.
  expiraEn DateTime

  @@index([expiraEn])
}
