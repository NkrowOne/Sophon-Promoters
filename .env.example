# ─── Base de datos ────────────────────────────────────────────────────────────
# En Skyway, apunta al Postgres gestionado del proyecto.
DATABASE_URL=postgresql://sophon:cambia-esto@localhost:5432/sophon_promoters

# ─── Credenciales de Sophon ───────────────────────────────────────────────────
# Cuenta maestra de afiliado (nivel 1). La de producción es Nkrowone+2@gmail.com.
#
# AVISO: a fecha de 2026-07-25 esa cuenta NO está en la whitelist del Tool API
# (comprobado: sub-aff/status responde "caller not in allowed list"). Mientras no
# se tramite con soporte de Sophon, activar webmasters y conceder PRO fallará.
# El resto de la aplicación —lectura de registros, ingresos y tesorería— sí opera.
# `npm run sophon:diagnostico` dice en qué estado está la cuenta ahora mismo.
SOPHON_EMAIL=
SOPHON_PASSWORD=
SOPHON_HOST=https://tool-api.newsophon.com

# ─── Cifrado en reposo ────────────────────────────────────────────────────────
# 32 bytes en base64. Genera uno con:  openssl rand -base64 32
# Cifra el token de Sophon y las wallets. Perderlo obliga a re-autenticar.
CLAVE_CIFRADO=

# Pimienta para el hash de los OTP. Distinta de la anterior.
PIMIENTA_OTP=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram devuelve en X-Telegram-Bot-Api-Secret-Token del webhook.
TELEGRAM_WEBHOOK_SECRET=
# ID numérico de la cuenta de Telegram del superadmin: recibe los avisos de retiro.
TELEGRAM_SUPERADMIN_ID=

# ─── Correo para los OTP ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE="Sophon Promoters <no-reply@example.com>"

# ─── Aplicación ───────────────────────────────────────────────────────────────
# URL pública donde se sirve la Mini App (Telegram exige HTTPS).
APP_URL=https://promoters.example.com
# Zona horaria de corte contable. Debe ser única y no cambiar: define qué día
# es cada devengo y cambiarla movería importes entre periodos ya cerrados.
ZONA_HORARIA=Europe/Madrid
