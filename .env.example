# ─── Base de datos ────────────────────────────────────────────────────────────
# En Skyway: la URL INTERNA de su Postgres gestionado, tal cual la da su panel,
# con `?connection_limit=10` al final. Sin ese tope Prisma abre
# `núcleos × 2 + 1` conexiones y agota el cupo de una base pequeña.
DATABASE_URL=postgresql://sophon:cambia-esto@localhost:5432/sophon_promoters?connection_limit=10

# Las tres de abajo son SOLO para `docker-compose.yml`, o sea para levantarlo en
# local: allí la composición arma el `DATABASE_URL` sola apuntando a su propio
# servicio `db` e ignora la línea de arriba. En Skyway no hacen falta —el
# Postgres lo pone él— y se pueden dejar vacías.
POSTGRES_USER=sophon
POSTGRES_PASSWORD=
POSTGRES_DB=sophon_promoters

# ─── Credenciales de Sophon ───────────────────────────────────────────────────
# Cuenta maestra de afiliado (nivel 1). La de producción es Nkrowone+2@gmail.com.
#
# AVISO: a fecha de 2026-07-25 esa cuenta NO está en la whitelist del Tool API
# (comprobado: sub-aff/status responde "caller not in allowed list"). Mientras no
# se tramite con soporte de Sophon, activar webmasters fallará —y con ello el
# año de PRO que va incluido en cada alta—.
# El resto de la aplicación —lectura de registros, ingresos y tesorería— sí opera.
# `npm run sophon:diagnostico` dice en qué estado está la cuenta ahora mismo.
SOPHON_EMAIL=
SOPHON_PASSWORD=
SOPHON_HOST=https://tool-api.newsophon.com

# ─── Cifrado en reposo ────────────────────────────────────────────────────────
# 32 bytes en base64. Genera uno con:  openssl rand -base64 32
# Cifra el token de Sophon y las wallets. Perderlo obliga a re-autenticar.
CLAVE_CIFRADO=

# Pimienta para el hash de los OTP. Distinta de la anterior.
PIMIENTA_OTP=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram devuelve en X-Telegram-Bot-Api-Secret-Token del webhook.
TELEGRAM_WEBHOOK_SECRET=
# ID numérico de la cuenta de Telegram del superadmin: recibe los avisos de retiro.
TELEGRAM_SUPERADMIN_ID=

# ─── Correo para los OTP ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE="Sophon Promoters <no-reply@example.com>"

# ─── Sincronización ───────────────────────────────────────────────────────────
# Secreto que protege /api/cron. Se envía en la cabecera x-cron-secret, no como
# parámetro de URL: los parámetros acaban en los logs de acceso de los proxies.
# Si no se define, la ruta queda deshabilitada (503) en vez de quedar abierta.
# Genera uno con:  openssl rand -hex 32
CRON_SECRET=

# Cadencia en el planificador de Skyway. Las horas van en UTC.
#
# La línea IMPORTANTE es la de las 16:05: Sophon cierra su día a las 00:00 UTC+8
# —que son las 16:00 UTC— y publica entonces los contadores del día que acaba.
# Cinco minutos después es cuando hay algo nuevo que leer. Las demás mantienen la
# pantalla fresca durante el día; esta es la que recoge el cierre.
#
#   5 16 * * *   curl -XPOST -H "x-cron-secret: $CRON_SECRET" $APP_URL/api/cron?tarea=todo
#   */30 * * * *  ... ?tarea=registros
#   */30 * * * *  ... ?tarea=webmasters
#   0    * * * *  ... ?tarea=tesoreria
#   30   7 * * *  ... ?tarea=avisos
#
# `avisos` faltaba aquí y es diario: el barrido se protege solo con su cerrojo
# —no manda dos veces el mismo día— pero sin una línea que lo dispare no corría
# más que dentro de `tarea=todo`.
#
# Si ninguna de estas líneas llega a ponerse, el panel lo dice: avisa arriba
# cuando no ha corrido ningún barrido de registros desde el último cierre de
# Sophon. Un planificador mal configurado no puede ser invisible.

# ─── Aplicación ───────────────────────────────────────────────────────────────
# URL pública donde se sirve la Mini App (Telegram exige HTTPS).
APP_URL=https://promoters.example.com
# Zona horaria de corte contable. Debe ser única y no cambiar: define qué día
# es cada devengo y cambiarla movería importes entre periodos ya cerrados.
#
# Es la de SOPHON, y por eso es UTC+8: ellos cierran su día a las 00:00 UTC+8 y
# la etiqueta de fecha de cada fila viene de ellos. Cortar el día en otro sitio
# hacía que «hoy» significara cosas distintas a cada lado del cable durante ocho
# horas al día. `Asia/Shanghai` es UTC+8 todo el año, sin horario de verano.
ZONA_HORARIA=Asia/Shanghai
